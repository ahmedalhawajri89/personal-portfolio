# Copy this file to .env.local and fill it in. .env.local is gitignored.
#
# Precedence: NEXT_PUBLIC_FORM_ENDPOINT wins when it is set; otherwise the
# form posts to Web3Forms with NEXT_PUBLIC_WEB3FORMS_KEY; with neither it opens
# the visitor's mail app. Production on Vercel sets only the Web3Forms key, so
# a local .env.local that also sets FORM_ENDPOINT tests a different provider
# from the live site. Both values are NEXT_PUBLIC_*: they ship in the page's
# JavaScript and are public by design, but keep them out of git anyway.
#
# Where the contact form posts. Leave empty and the form falls back to opening
# the visitor's mail app with the message composed (mailto:).
#   FormSubmit  https://formsubmit.co/ajax/<your-email-or-hash>   (no account)
#   Web3Forms   leave blank and set the key below instead
NEXT_PUBLIC_FORM_ENDPOINT=

# Web3Forms access key, used when NEXT_PUBLIC_FORM_ENDPOINT is empty.
NEXT_PUBLIC_WEB3FORMS_KEY=
